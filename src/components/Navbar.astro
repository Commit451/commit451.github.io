---
interface Props {
  variant?: 'default' | 'labcoat';
  accentColor?: 'accent' | 'teal';
}

const { variant = 'default', accentColor = 'accent' } = Astro.props;

const isAccent = accentColor === 'accent';
const hoverColor = isAccent ? 'hover:text-brand-accent' : 'hover:text-brand-teal';
const activeColor = isAccent ? 'text-brand-accent' : 'text-brand-teal';
const borderColor = isAccent ? 'border-brand-accent/60' : 'border-brand-teal/60';
const hoverBg = isAccent ? 'hover:bg-brand-accent/10' : 'hover:bg-brand-teal/10';

const brandHref = variant === 'default' ? '#hero' : '/';
---

<nav class="fixed top-0 left-0 right-0 z-50 border-b border-dark-700/50 bg-dark-950/80 backdrop-blur-md" aria-label="Main navigation">
  <div class="mx-auto max-w-6xl px-6 py-4 flex items-center justify-between">
    <a href={brandHref} class="flex items-center gap-3 group">
      <img src="/images/logo-v2.svg" alt="Commit 451 logo" width="36" height="36" class="transition-transform group-hover:scale-105">
      <span class="font-arcane text-lg text-white group-hover:text-brand-accent transition-colors">Commit 451</span>
    </a>

    {variant === 'labcoat' ? (
      <div class="hidden sm:flex items-center gap-8 text-sm font-medium">
        <a href="#features" class={`text-gray-400 ${hoverColor} transition-colors`}>Features</a>
        <a href="https://gitlab.com/Commit451/LabCoat" target="_blank" rel="noopener noreferrer" class={`text-gray-400 ${hoverColor} transition-colors`}>Source</a>
        <a href="https://play.google.com/store/apps/details?id=com.commit451.gitlab" target="_blank" rel="noopener noreferrer" class={`rounded-lg border ${borderColor} px-4 py-2 ${activeColor} ${hoverBg} transition-all`}>Get the App</a>
      </div>
    ) : (
      <div class="hidden sm:flex items-center gap-8 text-sm font-medium">
        <a href="#work" class={`text-gray-400 ${hoverColor} transition-colors`}>Work</a>
        <a href="#about" class={`text-gray-400 ${hoverColor} transition-colors`}>About</a>
        <a href="#services" class={`text-gray-400 ${hoverColor} transition-colors`}>Services</a>
        <a href="https://github.com/Commit451" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub" class={`flex items-center text-gray-400 ${hoverColor} transition-colors`}>
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 98 96" aria-hidden="true"><path d="M41.4395,69.3848C28.8066,67.8535 19.9062,58.7617 19.9062,46.9902C19.9062,42.2051 21.6289,37.0371 24.5,33.5918C23.2559,30.4336 23.4473,23.7344 24.8828,20.959C28.7109,20.4805 33.8789,22.4902 36.9414,25.2656C40.5781,24.1172 44.4062,23.543 49.0957,23.543C53.7852,23.543 57.6133,24.1172 61.0586,25.1699C64.0254,22.4902 69.2891,20.4805 73.1172,20.959C74.457,23.543 74.6484,30.2422 73.4043,33.4961C76.4668,37.1328 78.0937,42.0137 78.0937,46.9902C78.0937,58.7617 69.1934,67.6621 56.3691,69.2891C59.623,71.3945 61.8242,75.9883 61.8242,81.252L61.8242,91.2051C61.8242,94.0762 64.2168,95.7031 67.0879,94.5547C84.4102,87.9512 98,70.6289 98,49.1914C98,22.1074 75.9883,6.69539e-07 48.9043,4.309e-07C21.8203,1.92261e-07 -1.9479e-07,22.1074 -4.3343e-07,49.1914C-6.20631e-07,70.4375 13.4941,88.0469 31.6777,94.6504C34.2617,95.6074 36.75,93.8848 36.75,91.3008L36.75,83.6445C35.4102,84.2188 33.6875,84.6016 32.1562,84.6016C25.8398,84.6016 22.1074,81.1563 19.4277,74.7441C18.375,72.1602 17.2266,70.6289 15.0254,70.3418C13.877,70.2461 13.4941,69.7676 13.4941,69.1934C13.4941,68.0449 15.4082,67.1836 17.3223,67.1836C20.0977,67.1836 22.4902,68.9063 24.9785,72.4473C26.8926,75.2227 28.9023,76.4668 31.2949,76.4668C33.6875,76.4668 35.2187,75.6055 37.4199,73.4043C39.0469,71.7773 40.291,70.3418 41.4395,69.3848Z"/></svg>
        </a>
        <a href="https://cal.com/commit451/15min" target="_blank" rel="noopener noreferrer" class={`rounded-lg border ${borderColor} px-4 py-2 ${activeColor} ${hoverBg} transition-all`}>Book a Call</a>
      </div>
    )}

    <button id="menu-toggle" class="sm:hidden text-gray-400 hover:text-white" aria-label="Toggle menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </div>
  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden sm:hidden border-t border-dark-700/50 bg-dark-950/95 backdrop-blur-md">
    <div class="px-6 py-4 flex flex-col gap-4 text-sm font-medium">
      {variant === 'labcoat' ? (
        <>
          <a href="#features" class={`text-gray-400 ${hoverColor} transition-colors`}>Features</a>
          <a href="https://gitlab.com/Commit451/LabCoat" target="_blank" rel="noopener noreferrer" class={`text-gray-400 ${hoverColor} transition-colors`}>Source</a>
          <a href="https://play.google.com/store/apps/details?id=com.commit451.gitlab" target="_blank" rel="noopener noreferrer" class={activeColor}>Get the App</a>
        </>
      ) : (
        <>
          <a href="#work" class={`text-gray-400 ${hoverColor} transition-colors`}>Work</a>
          <a href="#about" class={`text-gray-400 ${hoverColor} transition-colors`}>About</a>
          <a href="#services" class={`text-gray-400 ${hoverColor} transition-colors`}>Services</a>
          <a href="https://github.com/Commit451" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub" class={`flex items-center text-gray-400 ${hoverColor} transition-colors`}>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 98 96" aria-hidden="true"><path d="M41.4395,69.3848C28.8066,67.8535 19.9062,58.7617 19.9062,46.9902C19.9062,42.2051 21.6289,37.0371 24.5,33.5918C23.2559,30.4336 23.4473,23.7344 24.8828,20.959C28.7109,20.4805 33.8789,22.4902 36.9414,25.2656C40.5781,24.1172 44.4062,23.543 49.0957,23.543C53.7852,23.543 57.6133,24.1172 61.0586,25.1699C64.0254,22.4902 69.2891,20.4805 73.1172,20.959C74.457,23.543 74.6484,30.2422 73.4043,33.4961C76.4668,37.1328 78.0937,42.0137 78.0937,46.9902C78.0937,58.7617 69.1934,67.6621 56.3691,69.2891C59.623,71.3945 61.8242,75.9883 61.8242,81.252L61.8242,91.2051C61.8242,94.0762 64.2168,95.7031 67.0879,94.5547C84.4102,87.9512 98,70.6289 98,49.1914C98,22.1074 75.9883,6.69539e-07 48.9043,4.309e-07C21.8203,1.92261e-07 -1.9479e-07,22.1074 -4.3343e-07,49.1914C-6.20631e-07,70.4375 13.4941,88.0469 31.6777,94.6504C34.2617,95.6074 36.75,93.8848 36.75,91.3008L36.75,83.6445C35.4102,84.2188 33.6875,84.6016 32.1562,84.6016C25.8398,84.6016 22.1074,81.1563 19.4277,74.7441C18.375,72.1602 17.2266,70.6289 15.0254,70.3418C13.877,70.2461 13.4941,69.7676 13.4941,69.1934C13.4941,68.0449 15.4082,67.1836 17.3223,67.1836C20.0977,67.1836 22.4902,68.9063 24.9785,72.4473C26.8926,75.2227 28.9023,76.4668 31.2949,76.4668C33.6875,76.4668 35.2187,75.6055 37.4199,73.4043C39.0469,71.7773 40.291,70.3418 41.4395,69.3848Z"/></svg>
          </a>
          <a href="https://cal.com/commit451/15min" target="_blank" rel="noopener noreferrer" class={activeColor}>Book a Call</a>
        </>
      )}
    </div>
  </div>
</nav>
